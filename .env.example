# Скопируйте в .env и заполните. Файл .env в Git не попадает.

# Обязательно для облачной LLM
OPENROUTER_API_KEY=

# Модели
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
EMBEDDING_MODEL=deepvk/USER2-base
EMBEDDING_MAX_LENGTH=1024

# Локальный резерв (GGUF), путь относительно корня проекта
LOCAL_LLM_PATH=Qwen2.5-7B-Instruct-Q4_K_M.gguf
LOCAL_LLM_CONTEXT=4096

# Данные и индекс
CORPUS_DIR=data
INDEX_DIR=chroma_db
INDEX_META_PATH=data/index_meta.json
MANIFEST_PATH=data/manifest.json
BM25_PATH=data/bm25_corpus.json
COLLECTION_NAME=course_materials
DENSE_MAX_PER_DOC=25
DEMO_CORPUS_DIR=data/demo

# API / UI
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
UI_PORT=8501
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Логи
LOG_LEVEL=INFO
LOG_DIR=logs
